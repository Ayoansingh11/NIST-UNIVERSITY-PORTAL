# Supabase Configuration (required in production)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Admin Authentication (use a unique password and a random secret of at least 32 bytes)
ADMIN_EMAIL=replace-with-admin-email
ADMIN_PASSWORD=replace-with-a-unique-strong-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
